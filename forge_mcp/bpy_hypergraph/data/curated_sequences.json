{
  "schema_tag": "blender-5.0.0-v1",
  "blender_version": "5.0.0",
  "sequences": [
    {
      "name": "reset_scene",
      "version": "v1",
      "description": "Wipe the current scene back to an empty state. Uses bpy.ops.wm.read_factory_settings(use_empty=True) which is the supported way to drop every datablock at once.",
      "inputs_schema": {},
      "outputs_schema": {},
      "steps": [
        {
          "call": "bpy.ops.wm.read_factory_settings",
          "params": {
            "use_empty": true
          },
          "expects": {
            "scene_diff": {
              "objects": {
                "eq": 0
              },
              "meshes": {
                "eq": 0
              },
              "materials": {
                "eq": 0
              },
              "images": {
                "eq": 0
              },
              "lights": {
                "eq": 0
              },
              "cameras": {
                "eq": 0
              },
              "curves": {
                "eq": 0
              }
            }
          }
        }
      ]
    },
    {
      "name": "create_terrain_from_heightmap",
      "version": "v1",
      "description": "Build a Mesh+Object terrain grid from raw vertex/face data, tag it with forge_node_id / forge_spec_id / forge_kind IDProperties, then attach a DISPLACE modifier driven by the full-res 16-bit heightmap PNG so the high-frequency detail returns even though the mesh itself is capped at 256x256.",
      "inputs_schema": {
        "object_name": "str",
        "vertices": "list[list[float]]",
        "faces": "list[list[int]]",
        "region_id": "str",
        "spec_id": "str",
        "heightmap_image_filepath": "str",
        "displace_strength": "float",
        "displace_midlevel": "float",
        "displace_modifier_name": "str",
        "displace_texture_name": "str"
      },
      "outputs_schema": {
        "object_name": "str"
      },
      "steps": [
        {
          "call": "mesh.from_pydata",
          "params": {
            "name": "${object_name}",
            "vertices": "${vertices}",
            "edges": [],
            "faces": "${faces}"
          },
          "expects": {
            "scene_diff": {
              "objects": {
                "delta": 1
              },
              "meshes": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "set_idprop",
          "params": {
            "collection": "objects",
            "name": "${object_name}",
            "key": "forge_node_id",
            "value": "${region_id}"
          }
        },
        {
          "call": "set_idprop",
          "params": {
            "collection": "objects",
            "name": "${object_name}",
            "key": "forge_spec_id",
            "value": "${spec_id}"
          }
        },
        {
          "call": "set_idprop",
          "params": {
            "collection": "objects",
            "name": "${object_name}",
            "key": "forge_kind",
            "value": "terrain_mesh"
          }
        },
        {
          "call": "mesh.add_displace_modifier",
          "params": {
            "object_name": "${object_name}",
            "image_filepath": "${heightmap_image_filepath}",
            "modifier_name": "${displace_modifier_name}",
            "texture_name": "${displace_texture_name}",
            "strength": "${displace_strength}",
            "midlevel": "${displace_midlevel}"
          }
        }
      ]
    },
    {
      "name": "apply_terrain_material",
      "version": "v1",
      "description": "Build the composite material from a resolved CompositeMaterialPlan and bind it to the target mesh. The plan carries an ordered list of resolved layers; the adapter's recipe registry instantiates each archetype's shader graph and composites them via MixShader nodes driven by per-layer mask specs. The plan_id is the deterministic content hash; two regions resolving to the same plan share one Blender material data-block. After the surface material is bound, the dedicated material.attach_instancer step picks up any instancer-routed layers (Phase 6-e Stage F: list is always empty until Stage D wires PROCEDURAL_GRASS).",
      "inputs_schema": {
        "object_name": "str",
        "plan": "CompositeMaterialPlan",
        "plan_id": "str",
        "instancer_layers": "list"
      },
      "outputs_schema": {
        "material_name": "str",
        "plan_id": "str"
      },
      "steps": [
        {
          "call": "material.build_composite",
          "params": {
            "target_object": "${object_name}",
            "plan": "${plan}"
          },
          "expects": {
            "scene_diff": {
              "materials": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "material.attach_instancer",
          "params": {
            "target_object": "${object_name}",
            "plan_id": "${plan_id}",
            "instancer_layers": "${instancer_layers}"
          }
        }
      ]
    },
    {
      "name": "carve_stream",
      "version": "v1",
      "description": "Materialise the optional stream geometry as a curve object with a water material. Engine skips this entry when stream_geometry is None.",
      "inputs_schema": {
        "curve_name": "str",
        "region_id": "str"
      },
      "outputs_schema": {
        "curve_name": "str"
      },
      "steps": [
        {
          "call": "bpy.data.curves.new",
          "params": {
            "name": "${curve_name}",
            "type": "CURVE"
          },
          "expects": {
            "scene_diff": {
              "curves": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "set_idprop",
          "params": {
            "collection": "curves",
            "name": "${curve_name}",
            "key": "forge_node_id",
            "value": "${region_id}"
          }
        },
        {
          "call": "set_idprop",
          "params": {
            "collection": "curves",
            "name": "${curve_name}",
            "key": "forge_kind",
            "value": "stream_curve"
          }
        }
      ]
    },
    {
      "name": "set_camera_overview",
      "version": "v1",
      "description": "Create and configure the ortho-top and SE-perspective cameras that frame the realised region. Each camera data-block is wrapped in a scene-linked object so render.to_file can resolve it as scene.camera; the data-block itself is then switched to ORTHO / sized via ortho_scale, and the wrapping object is positioned + rotated to actually look at the terrain. Without these set_property steps the cameras stay at the Blender default (0,0,0)/PERSP and the renders come out solid grey.",
      "inputs_schema": {
        "ortho_camera_name": "str",
        "perspective_camera_name": "str",
        "ortho_location": "list[float]",
        "ortho_rotation_euler": "list[float]",
        "ortho_scale": "float",
        "perspective_location": "list[float]",
        "perspective_rotation_euler": "list[float]"
      },
      "outputs_schema": {
        "ortho_camera_name": "str",
        "perspective_camera_name": "str"
      },
      "steps": [
        {
          "call": "bpy.data.cameras.new",
          "params": {
            "name": "${ortho_camera_name}"
          },
          "expects": {
            "scene_diff": {
              "cameras": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "object.from_data",
          "params": {
            "name": "${ortho_camera_name}",
            "data_collection": "cameras",
            "data_name": "${ortho_camera_name}"
          },
          "expects": {
            "scene_diff": {
              "objects": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "cameras",
            "name": "${ortho_camera_name}",
            "path": "type",
            "value": "ORTHO"
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "cameras",
            "name": "${ortho_camera_name}",
            "path": "ortho_scale",
            "value": "${ortho_scale}"
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "cameras",
            "name": "${ortho_camera_name}",
            "path": "clip_end",
            "value": 100000.0
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "objects",
            "name": "${ortho_camera_name}",
            "path": "location",
            "value": "${ortho_location}"
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "objects",
            "name": "${ortho_camera_name}",
            "path": "rotation_euler",
            "value": "${ortho_rotation_euler}"
          }
        },
        {
          "call": "bpy.data.cameras.new",
          "params": {
            "name": "${perspective_camera_name}"
          },
          "expects": {
            "scene_diff": {
              "cameras": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "object.from_data",
          "params": {
            "name": "${perspective_camera_name}",
            "data_collection": "cameras",
            "data_name": "${perspective_camera_name}"
          },
          "expects": {
            "scene_diff": {
              "objects": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "cameras",
            "name": "${perspective_camera_name}",
            "path": "clip_end",
            "value": 100000.0
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "objects",
            "name": "${perspective_camera_name}",
            "path": "location",
            "value": "${perspective_location}"
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "objects",
            "name": "${perspective_camera_name}",
            "path": "rotation_euler",
            "value": "${perspective_rotation_euler}"
          }
        }
      ]
    },
    {
      "name": "add_basic_lighting",
      "version": "v1",
      "description": "Sun lamp plus procedural sky world. The sun data-block is wrapped in a scene-linked object so it actually casts and is then rotated to a fixed off-zenith angle (default Euler is (0,0,0) which makes the sun point straight down, washing out terrain relief); the world data-block is bound via scene.assign_world. Constants chosen for shadow consistency across regions.",
      "inputs_schema": {
        "sun_name": "str",
        "world_name": "str",
        "sun_location": "list[float]",
        "sun_rotation_euler": "list[float]"
      },
      "outputs_schema": {},
      "steps": [
        {
          "call": "bpy.data.lights.new",
          "params": {
            "name": "${sun_name}",
            "type": "SUN"
          },
          "expects": {
            "scene_diff": {
              "lights": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "object.from_data",
          "params": {
            "name": "${sun_name}",
            "data_collection": "lights",
            "data_name": "${sun_name}"
          },
          "expects": {
            "scene_diff": {
              "objects": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "objects",
            "name": "${sun_name}",
            "path": "location",
            "value": "${sun_location}"
          }
        },
        {
          "call": "set_property",
          "params": {
            "collection": "objects",
            "name": "${sun_name}",
            "path": "rotation_euler",
            "value": "${sun_rotation_euler}"
          }
        },
        {
          "call": "bpy.data.worlds.new",
          "params": {
            "name": "${world_name}"
          },
          "expects": {
            "scene_diff": {
              "worlds": {
                "delta": 1
              }
            }
          }
        },
        {
          "call": "scene.assign_world",
          "params": {
            "name": "${world_name}"
          }
        }
      ]
    },
    {
      "name": "apply_environment",
      "version": "v1",
      "description": "Phase 6-f Stage D: build the world shader graph + cached SUN lamp from a ResolvedEnvironment payload. Single RPC call (world.build_environment) is idempotent on plan_id; a second call with the same plan reuses the existing forge.world.<plan_id> + forge.sun.<plan_id> data-blocks. The adapter ensures both data-blocks exist (creating them on first sight), updates the world background + optional volume + optional sky-texture nodes from the resolved parameters, points the SUN lamp at the resolved sun_vector, and rebinds them to the active scene via scene.assign_world.",
      "inputs_schema": {
        "plan": "ResolvedEnvironment",
        "plan_id": "str"
      },
      "outputs_schema": {
        "world_name": "str",
        "sun_name": "str",
        "plan_id": "str"
      },
      "steps": [
        {
          "call": "world.build_environment",
          "params": {
            "plan": "${plan}",
            "plan_id": "${plan_id}"
          }
        }
      ]
    },
    {
      "name": "render_preview",
      "version": "v1",
      "description": "Configure scene.render.engine plus the Cycles compute device, then render the active scene through the named camera at the requested resolution / engine to a PNG. The host facade re-runs this macro once with compression bumped from 15 to 100 if the engine reports the file exceeded ${png_max_bytes}.",
      "inputs_schema": {
        "filepath": "str",
        "resolution_x": "int",
        "resolution_y": "int",
        "camera_name": "str",
        "engine": "str",
        "device_type": "str",
        "cycles_samples": "int",
        "compression": "int",
        "png_max_bytes": "int"
      },
      "outputs_schema": {
        "path": "str",
        "file_size_bytes": "int"
      },
      "steps": [
        {
          "call": "render.set_engine_device",
          "params": {
            "engine": "${engine}",
            "device_type": "${device_type}",
            "samples": "${cycles_samples}"
          }
        },
        {
          "call": "render.to_file",
          "params": {
            "filepath": "${filepath}",
            "resolution_x": "${resolution_x}",
            "resolution_y": "${resolution_y}",
            "camera_name": "${camera_name}",
            "engine": "${engine}",
            "file_format": "PNG",
            "color_mode": "RGB",
            "color_depth": "8",
            "compression": "${compression}"
          },
          "expects": {
            "png_max_bytes": "${png_max_bytes}"
          }
        }
      ]
    },
    {
      "name": "save_blend",
      "version": "v1",
      "description": "Save the current main file via bpy.ops.wm.save_as_mainfile. Engine writes through a .blend.tmp + os.replace at the host side for atomicity (the actual rename is host-side, not in this sequence).",
      "inputs_schema": {
        "filepath": "str"
      },
      "outputs_schema": {
        "filepath": "str"
      },
      "steps": [
        {
          "call": "bpy.ops.wm.save_as_mainfile",
          "params": {
            "filepath": "${filepath}"
          }
        }
      ]
    },
    {
      "name": "realize_region",
      "version": "v1",
      "description": "Composite v1 macro: empty scene \u2192 terrain mesh \u2192 composite material \u2192 optional stream \u2192 cameras \u2192 lighting \u2192 save .blend. Render is driven separately by render_preview because both ortho and perspective views need to flow through the same realised scene.",
      "inputs_schema": {
        "object_name": "str",
        "vertices": "list[list[float]]",
        "faces": "list[list[int]]",
        "region_id": "str",
        "spec_id": "str",
        "plan": "CompositeMaterialPlan",
        "plan_id": "str",
        "instancer_layers": "list",
        "curve_name": "str",
        "ortho_camera_name": "str",
        "perspective_camera_name": "str",
        "ortho_location": "list[float]",
        "ortho_rotation_euler": "list[float]",
        "ortho_scale": "float",
        "perspective_location": "list[float]",
        "perspective_rotation_euler": "list[float]",
        "sun_name": "str",
        "world_name": "str",
        "sun_location": "list[float]",
        "sun_rotation_euler": "list[float]",
        "blend_filepath": "str",
        "heightmap_image_filepath": "str",
        "displace_strength": "float",
        "displace_midlevel": "float",
        "displace_modifier_name": "str",
        "displace_texture_name": "str"
      },
      "outputs_schema": {
        "blend_filepath": "str"
      },
      "steps": [
        {
          "call": "seq:reset_scene",
          "params": {}
        },
        {
          "call": "seq:create_terrain_from_heightmap",
          "params": {}
        },
        {
          "call": "seq:apply_terrain_material",
          "params": {}
        },
        {
          "call": "seq:carve_stream",
          "params": {}
        },
        {
          "call": "seq:set_camera_overview",
          "params": {}
        },
        {
          "call": "seq:add_basic_lighting",
          "params": {}
        },
        {
          "call": "seq:save_blend",
          "params": {
            "filepath": "${blend_filepath}"
          }
        }
      ]
    }
  ]
}
